{
  "name": "ogame",
  "version": "0.1.0",
  "description": "OGame notes server",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node apps/server/dist/index.js",
    "clean": "rimraf apps/*/dist apps/*/*.tsbuildinfo",
    "dev": "concurrently -n api,client -c cyan,magenta \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "npm -w @ogame/server run dev",
    "dev:client": "npm -w @ogame/client run dev",
    "build": "npm run build:api && npm run build:client",
    "build:api": "npm -w @ogame/server run build",
    "build:client": "npm -w @ogame/client run build",
    "typecheck": "npm run typecheck:api && npm run typecheck:client",
    "typecheck:api": "npm -w @ogame/server run typecheck",
    "typecheck:client": "npm -w @ogame/client run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.{ts,css,json,md}": [
      "prettier --write"
    ]
  }
}
